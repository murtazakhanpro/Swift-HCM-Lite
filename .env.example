# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (Set a strong 32+ char secret in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Docker/Production, SQLite for zero-install local evaluation)
DATABASE_URL=sqlite+aiosqlite:///./swift_hcm.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swift_hcm

# AI / Hosted LLM API Key (Must never be committed to Git)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
